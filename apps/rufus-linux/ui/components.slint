import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component FieldLabel inherits Text {
    in property <string> label;
    text: label;
    color: Theme.text;
    font-family: Theme.body-font;
    font-size: 12px;
    font-weight: 600;
    vertical-alignment: center;
}

export component HelperLabel inherits Text {
    in property <string> message;
    in property <bool> is-error: false;
    text: message;
    color: is-error ? Theme.danger : Theme.muted;
    font-family: Theme.body-font;
    font-size: 12px;
    wrap: word-wrap;
}

export component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    height: 40px;
    spacing: Theme.space-3;
    alignment: center;

    Text {
        height: 24px;
        vertical-stretch: 0;
        text: root.title;
        color: Theme.text;
        font-family: Theme.display-font;
        font-size: 18px;
        font-weight: 600;
        vertical-alignment: center;
    }

    Rectangle {
        height: Theme.high-contrast ? 2px : 1px;
        horizontal-stretch: 1;
        background: Theme.border;
    }
}

export component WorkbenchButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    in property <bool> initial-focus: false;
    in property <bool> handles-escape: false;
    in property <string> accessible-name: text;
    callback clicked;
    callback escape-pressed;

    height: Theme.control-height;
    min-width: compact ? 36px : 96px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: button-focus.has-focus ? 2px : (primary ? 0px : Theme.border-width);
    border-color: button-focus.has-focus ? Theme.focus : (danger ? Theme.danger : (touch.has-hover ? Theme.muted : Theme.border));
    background: !enabled ? Theme.track
        : danger ? (touch.pressed ? Theme.danger : (touch.has-hover ? Theme.danger-soft : Theme.surface-raised))
        : primary ? (touch.pressed ? Theme.accent-strong : Theme.accent)
        : touch.has-hover ? Theme.accent-soft : Theme.surface-raised;
    opacity: enabled ? 1.0 : 0.48;
    accessible-role: button;
    accessible-label: accessible-name;
    accessible-enabled: enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: button-focus;
    init => {
        if root.initial-focus { button-focus.focus(); }
    }

    if root.icon.width > 0 && root.icon.height > 0: Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: root.danger ? Theme.danger : (root.primary ? Theme.accent-ink : Theme.text);
    }

    if root.icon.width == 0 || root.icon.height == 0: Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.danger ? Theme.danger : (root.primary ? Theme.accent-ink : Theme.text);
        font-family: Theme.body-font;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    button-focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if root.handles-escape && event.text == Key.Escape {
                root.escape-pressed();
                return accept;
            }
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked;

    width: Theme.icon-button-size;
    height: Theme.icon-button-size;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    background: selected ? Theme.selection-soft : (touch.has-hover ? Theme.surface-raised : transparent);
    border-width: tool-focus.has-focus ? 2px : (selected ? Theme.border-width : 0px);
    border-color: tool-focus.has-focus ? Theme.focus : (selected ? Theme.selection : transparent);
    opacity: enabled ? 1 : 0.42;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: tool-focus;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: root.selected ? Theme.selection : Theme.muted;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    tool-focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component StatusBadge inherits Rectangle {
    in property <string> text;
    in property <string> tone: "neutral";
    height: 24px;
    min-width: badge-text.preferred-width + 18px;
    border-radius: 12px;
    border-width: Theme.border-width;
    border-color: tone == "warning" ? Theme.warning : (tone == "danger" ? Theme.danger : (tone == "success" ? Theme.accent : Theme.border));
    background: tone == "warning" ? Theme.warning-soft : (tone == "danger" ? Theme.danger-soft : (tone == "success" ? Theme.accent-soft : Theme.surface-raised));

    badge-text := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.tone == "warning" ? Theme.warning : (root.tone == "danger" ? Theme.danger : (root.tone == "success" ? Theme.accent : Theme.muted));
        font-family: Theme.body-font;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component LabeledLineEdit inherits VerticalLayout {
    in property <string> label;
    in property <string> helper: "";
    in property <bool> enabled: true;
    in property <bool> invalid: false;
    in property <string> accessible-name: label;
    in-out property <string> value <=> input.text;
    spacing: Theme.space-1;

    FieldLabel { label: root.label; }
    input := LineEdit {
        enabled: root.enabled;
        accessible-label: root.accessible-name;
    }
    if root.helper != "": HelperLabel { message: root.helper; is-error: root.invalid; }
}

export component LabeledComboBox inherits VerticalLayout {
    in property <string> label;
    in property <[string]> choices;
    in property <bool> enabled: true;
    in property <string> helper: "";
    in-out property <string> value <=> combo.current-value;
    callback selected(string);
    spacing: Theme.space-1;

    FieldLabel { label: root.label; }
    combo := ComboBox {
        model: root.choices;
        enabled: root.enabled;
        accessible-label: root.label;
        selected(value) => { root.selected(value); }
    }
    if root.helper != "": HelperLabel { message: root.helper; }
}

export component TargetPlate inherits Rectangle {
    in property <string> device-name: "SanDisk Ultra";
    in property <string> device-path: "/dev/sdb";
    in property <string> capacity: "31.9 GB";
    in property <bool> destructive: false;

    height: 54px;
    border-radius: Theme.control-radius;
    border-width: Theme.border-width;
    border-color: destructive ? Theme.warning : Theme.border;
    background: destructive ? Theme.warning-soft : Theme.surface-raised;
    accessible-role: groupbox;
    accessible-label: "Target device " + device-name + ", " + device-path + ", " + capacity;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.device-name;
                color: Theme.text;
                font-family: Theme.body-font;
                font-size: 13px;
                font-weight: 600;
            }
            Text {
                text: root.device-path;
                color: Theme.muted;
                font-family: Theme.data-font;
                font-size: 11px;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.capacity;
            color: destructive ? Theme.warning : Theme.text;
            font-family: Theme.data-font;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Rufus's signature progress element: exactly sixteen flash-memory blocks.
export component WriteTrack inherits Rectangle {
    in property <string> phase: "READY";
    in property <string> operation: "Ready to write";
    in property <float> progress: 0;
    in property <string> telemetry: "31.9 GB";
    in property <string> tone: "neutral";
    in property <bool> active: false;

    height: 72px;
    border-radius: Theme.control-radius;
    border-width: Theme.border-width;
    border-color: tone == "error" ? Theme.danger : (tone == "warning" ? Theme.warning : Theme.border);
    background: Theme.surface-raised;
    accessible-role: progress-indicator;
    accessible-label: operation;
    accessible-value: progress;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-description: phase + ", " + round(progress) + " percent, " + telemetry;

    VerticalLayout {
        padding: Theme.space-2;
        spacing: Theme.space-2;

        HorizontalLayout {
            Text {
                text: root.phase;
                color: root.tone == "error" ? Theme.danger : (root.tone == "warning" ? Theme.warning : (root.active ? Theme.accent : Theme.muted));
                font-family: Theme.data-font;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 0.6px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.telemetry;
                color: Theme.text;
                font-family: Theme.data-font;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        progress-trough := Rectangle {
            height: 18px;
            clip: true;
            border-radius: 3px;
            border-width: Theme.high-contrast ? 2px : 1px;
            border-color: Theme.border;
            background: Theme.track;

            Rectangle {
                width: max(0px, min(parent.width, parent.width * root.progress / 100));
                height: parent.height;
                background: root.tone == "error" ? Theme.danger
                    : root.tone == "warning" ? Theme.warning
                    : Theme.accent;
            }
        }
    }
}
