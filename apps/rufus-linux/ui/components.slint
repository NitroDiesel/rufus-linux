import { Theme } from "theme.slint";

export component FieldLabel inherits Text {
    in property <string> label;
    text: label;
    color: Theme.text;
    font-family: Theme.body-font;
    font-size: 12px;
    font-weight: 500;
    vertical-alignment: center;
    overflow: elide;
}

export component HelperLabel inherits Text {
    in property <string> message;
    in property <bool> is-error: false;
    text: message;
    color: is-error ? Theme.danger : Theme.muted;
    font-family: Theme.body-font;
    font-size: 12px;
    wrap: word-wrap;
}

// Tinted inline alert. Tones: neutral, warning, danger.
export component Callout inherits Rectangle {
    in property <string> message;
    in property <string> tone: "neutral";
    border-radius: Theme.control-radius;
    border-width: Theme.border-width;
    border-color: tone == "danger" ? Theme.danger.with-alpha(0.32)
        : tone == "warning" ? Theme.warning.with-alpha(0.32) : Theme.border;
    background: tone == "danger" ? Theme.danger-soft : (tone == "warning" ? Theme.warning-soft : Theme.inset);
    accessible-role: text;
    accessible-label: message;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-2;
        VerticalLayout {
            padding-top: 6px;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.tone == "danger" ? Theme.danger : (root.tone == "warning" ? Theme.warning : Theme.muted);
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.message;
            color: root.tone == "danger" ? Theme.danger : (root.tone == "warning" ? Theme.warning : Theme.muted);
            font-family: Theme.body-font;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// Card title row. Extra children (badges, counters) sit on the right edge.
export component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    height: 24px;
    spacing: Theme.space-2;

    Text {
        horizontal-stretch: 1;
        text: root.title;
        color: Theme.text;
        font-family: Theme.display-font;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    @children
}

export component Card inherits Rectangle {
    in property <string> tone: "neutral";
    border-radius: Theme.section-radius;
    border-width: Theme.border-width;
    border-color: tone == "warning" ? Theme.warning.with-alpha(0.4) : Theme.border;
    background: Theme.surface;

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;
        @children
    }
}

export component WorkbenchButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    in property <bool> initial-focus: false;
    in property <bool> handles-escape: false;
    out property <bool> has-keyboard-focus: button-focus.has-focus;
    in property <string> accessible-name: text;
    callback clicked;
    callback escape-pressed;

    public function focus-button() {
        if root.enabled { button-focus.focus(); }
    }

    property <bool> has-icon: root.icon.width > 0 && root.icon.height > 0;
    property <color> ink: !enabled ? Theme.muted
        : primary ? Theme.accent-ink
        : danger ? (touch.pressed ? Theme.accent-ink : Theme.danger)
        : Theme.text;

    height: Theme.control-height;
    min-width: compact ? Theme.control-height : max(88px, label.preferred-width + 2 * Theme.space-4);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: primary && enabled ? 0px : Theme.border-width;
    border-color: danger && enabled ? Theme.danger.with-alpha(0.45) : Theme.input;
    background: !enabled ? (primary ? Theme.track : transparent)
        : primary ? (touch.pressed ? Theme.accent-strong : (touch.has-hover ? Theme.accent.brighter(0.08) : Theme.accent))
        : danger ? (touch.pressed ? Theme.danger-solid : (touch.has-hover ? Theme.danger-soft : transparent))
        : touch.pressed ? Theme.pressed : (touch.has-hover ? Theme.hover : transparent);
    accessible-role: button;
    accessible-label: accessible-name;
    accessible-enabled: enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: button-focus;
    init => {
        if root.initial-focus { button-focus.focus(); }
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: parent.border-radius + 3px;
        border-width: 2px;
        border-color: button-focus.has-focus ? Theme.focus.with-alpha(0.55) : transparent;
    }

    if root.has-icon: Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: root.ink;
    }

    label := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        visible: !root.has-icon;
        text: root.has-icon ? "" : root.text;
        color: root.ink;
        font-family: Theme.body-font;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    button-focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if root.handles-escape && event.text == Key.Escape {
                root.escape-pressed();
                return accept;
            }
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component ModalOverlay inherits FocusScope {
    in property <bool> keyboard-scroll-enabled: false;
    callback dismiss;
    callback advance-focus;
    callback restore-focus;
    callback scroll-content(float);

    changed has-focus => {
        if self.has-focus { root.restore-focus(); }
    }
    key-pressed(event) => {
        if event.text == Key.Escape {
            root.dismiss();
            return accept;
        }
        if event.text == Key.Tab || event.text == Key.Backtab {
            root.advance-focus();
            return accept;
        }
        if root.keyboard-scroll-enabled {
            if event.text == Key.DownArrow || event.text == Key.PageDown {
                root.scroll-content(event.text == Key.PageDown ? -160 : -32);
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.PageUp {
                root.scroll-content(event.text == Key.PageUp ? 160 : 32);
                return accept;
            }
        }
        return reject;
    }

    Rectangle { background: Theme.scrim; }
    TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.restore-focus(); }
        }
        scroll-event(event) => { accept }
    }
    @children
}

// Dialog surface used inside a ModalOverlay.
export component DialogPanel inherits Rectangle {
    in property <string> title;
    in property <string> tone: "neutral";
    border-radius: Theme.section-radius;
    border-width: Theme.border-width;
    border-color: tone == "danger" ? Theme.danger.with-alpha(0.45) : Theme.border;
    background: Theme.surface-raised;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000059;
    clip: false;
}

export component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked;

    width: Theme.icon-button-size;
    height: Theme.icon-button-size;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    background: selected ? Theme.selection-soft
        : !enabled ? transparent
        : touch.pressed ? Theme.pressed
        : touch.has-hover ? Theme.hover : transparent;
    border-width: tool-focus.has-focus ? 2px : 0px;
    border-color: tool-focus.has-focus ? Theme.focus.with-alpha(0.7) : transparent;
    opacity: enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: tool-focus;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: root.selected ? Theme.selection : (touch.has-hover && root.enabled ? Theme.text : Theme.muted);
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    tool-focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component StatusBadge inherits Rectangle {
    in property <string> text;
    in property <string> tone: "neutral";
    property <color> ink: tone == "warning" ? Theme.warning
        : tone == "danger" ? Theme.danger
        : tone == "success" ? Theme.success : Theme.muted;
    height: 22px;
    width: badge-text.preferred-width + 26px;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: tone == "warning" ? Theme.warning-soft
        : tone == "danger" ? Theme.danger-soft
        : tone == "success" ? Theme.success-soft : Theme.track;

    Rectangle {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.ink;
    }
    badge-text := Text {
        x: 18px;
        y: 0px;
        height: parent.height;
        text: root.text;
        color: root.ink;
        font-family: Theme.body-font;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

// Single-line text input styled like a T3 Code field.
export component TextField inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> accessible-name;
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;

    height: Theme.field-height;
    border-radius: Theme.control-radius;
    border-width: Theme.border-width;
    border-color: input.has-focus ? Theme.focus : Theme.input;
    background: enabled ? Theme.inset : transparent;
    opacity: enabled ? 1 : 0.55;
    forward-focus: input;

    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: parent.border-radius + 3px;
        border-width: 3px;
        border-color: input.has-focus ? Theme.focus.with-alpha(0.22) : transparent;
    }

    input := TextInput {
        x: Theme.space-3;
        width: parent.width - 2 * Theme.space-3;
        height: parent.height;
        enabled: root.enabled;
        single-line: true;
        color: Theme.text;
        selection-background-color: Theme.selection.with-alpha(0.35);
        selection-foreground-color: Theme.text;
        font-family: Theme.body-font;
        font-size: 13px;
        vertical-alignment: center;
        accessible-role: text-input;
        accessible-label: root.accessible-name;
    }
}

// Select control. Arrow keys step through choices without opening the list;
// Space, Enter, or Alt+Down opens it.
export component SelectField inherits Rectangle {
    in property <[string]> choices;
    in property <bool> enabled: true;
    in property <string> accessible-name;
    // A controlled field only reports selections; the owner updates `value`.
    in property <bool> controlled: false;
    in property <string> placeholder: "";
    in-out property <string> value;
    callback selected(string);

    property <int> current-index: -1;
    min-width: 72px;
    preferred-width: 160px;
    property <bool> can-open: root.enabled && root.choices.length > 0;

    function pick(index: int) {
        if index < 0 || index >= root.choices.length { return; }
        if !root.controlled { root.value = root.choices[index]; }
        root.current-index = index;
        root.selected(root.choices[index]);
    }

    height: Theme.field-height;
    border-radius: Theme.control-radius;
    border-width: Theme.border-width;
    border-color: field-focus.has-focus ? Theme.focus : Theme.input;
    background: !enabled ? transparent : (touch.has-hover ? Theme.hover : Theme.inset);
    opacity: enabled ? 1 : 0.55;
    accessible-role: combobox;
    accessible-label: accessible-name;
    accessible-value: value;
    accessible-enabled: enabled;
    forward-focus: field-focus;

    for choice[i] in root.choices: Rectangle {
        width: 0px;
        height: 0px;
        visible: false;
        property <bool> current: choice == root.value;
        init => { if self.current { root.current-index = i; } }
        changed current => { if self.current { root.current-index = i; } }
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: parent.border-radius + 3px;
        border-width: 3px;
        border-color: field-focus.has-focus ? Theme.focus.with-alpha(0.22) : transparent;
    }

    Text {
        x: Theme.space-3;
        width: parent.width - Theme.space-3 - 32px;
        height: parent.height;
        text: root.value == "" ? root.placeholder : root.value;
        color: root.value == "" ? Theme.muted : Theme.text;
        font-family: Theme.body-font;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    Image {
        x: parent.width - 26px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: @image-url("../../../assets/icons/toolbar/chevron.svg");
        colorize: Theme.muted;
    }

    touch := TouchArea {
        enabled: root.can-open;
        mouse-cursor: pointer;
        clicked => {
            field-focus.focus();
            list.show();
        }
    }

    field-focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if !root.can-open { return reject; }
            if event.text == Key.DownArrow && event.modifiers.alt {
                list.show();
                return accept;
            }
            if event.text == Key.DownArrow {
                root.pick(min(root.current-index + 1, root.choices.length - 1));
                return accept;
            }
            if event.text == Key.UpArrow {
                root.pick(max(root.current-index - 1, 0));
                return accept;
            }
            if event.text == Key.Home {
                root.pick(0);
                return accept;
            }
            if event.text == Key.End {
                root.pick(root.choices.length - 1);
                return accept;
            }
            if event.text == " " || event.text == "\n" {
                list.show();
                return accept;
            }
            return reject;
        }
    }

    list := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: min(root.choices.length * 32px + 10px, 260px);

        Rectangle {
            border-radius: Theme.control-radius + 2px;
            border-width: Theme.border-width;
            border-color: Theme.border;
            background: Theme.surface-raised;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
            clip: true;

            Flickable {
                x: 4px;
                y: 5px;
                width: parent.width - 8px;
                height: parent.height - 10px;
                viewport-height: root.choices.length * 32px;
                for choice[i] in root.choices: Rectangle {
                    y: i * 32px;
                    width: parent.width;
                    height: 32px;
                    border-radius: 6px;
                    background: item-touch.has-hover ? Theme.hover : transparent;
                    Text {
                        x: Theme.space-2;
                        width: parent.width - Theme.space-2 - 28px;
                        height: parent.height;
                        text: choice;
                        color: Theme.text;
                        font-family: Theme.body-font;
                        font-size: 13px;
                        font-weight: choice == root.value ? 500 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if choice == root.value: Image {
                        x: parent.width - 24px;
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        source: @image-url("../../../assets/icons/toolbar/check.svg");
                        colorize: Theme.accent;
                    }
                    item-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick(i); }
                    }
                }
            }
        }
    }
}

export component CheckRow inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked: false;
    callback toggled;

    function toggle() {
        if !root.enabled { return; }
        root.checked = !root.checked;
        root.toggled();
    }

    height: 24px;
    min-width: box.width + Theme.space-2 + caption.preferred-width;
    opacity: enabled ? 1 : 0.55;
    accessible-role: checkbox;
    accessible-label: text;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-action-default => { root.toggle(); }
    forward-focus: check-focus;

    box := Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 4px;
        border-width: root.checked ? 0px : Theme.border-width;
        border-color: Theme.input;
        background: root.checked ? Theme.accent : (touch.has-hover ? Theme.hover : Theme.inset);

        Rectangle {
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: 6px;
            border-width: 2px;
            border-color: check-focus.has-focus ? Theme.focus.with-alpha(0.55) : transparent;
        }
        if root.checked: Image {
            x: 2px;
            y: 2px;
            width: 12px;
            height: 12px;
            source: @image-url("../../../assets/icons/toolbar/check.svg");
            colorize: Theme.accent-ink;
        }
    }

    caption := Text {
        x: box.width + Theme.space-2;
        height: parent.height;
        text: root.text;
        color: Theme.text;
        font-family: Theme.body-font;
        font-size: 13px;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            check-focus.focus();
            root.toggle();
        }
    }

    check-focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }
}

export component LabeledLineEdit inherits VerticalLayout {
    in property <string> label;
    in property <string> helper: "";
    in property <bool> enabled: true;
    in property <bool> invalid: false;
    in property <string> accessible-name: label;
    in-out property <string> value <=> input.text;
    spacing: 6px;

    FieldLabel { label: root.label; }
    input := TextField {
        enabled: root.enabled;
        accessible-name: root.accessible-name;
    }
    if root.helper != "": HelperLabel { message: root.helper; is-error: root.invalid; }
}

export component LabeledComboBox inherits VerticalLayout {
    in property <string> label;
    in property <[string]> choices;
    in property <bool> enabled: true;
    in property <bool> controlled: false;
    in property <string> helper: "";
    in-out property <string> value <=> combo.value;
    callback selected(string);
    min-width: 72px;
    preferred-width: 160px;
    spacing: 6px;

    FieldLabel { label: root.label; }
    combo := SelectField {
        choices: root.choices;
        enabled: root.enabled;
        controlled: root.controlled;
        accessible-name: root.label;
        selected(value) => { root.selected(value); }
    }
    if root.helper != "": HelperLabel { message: root.helper; }
}

export component TargetPlate inherits Rectangle {
    in property <string> device-name: "SanDisk Ultra";
    in property <string> device-path: "/dev/sdb";
    in property <string> capacity: "31.9 GB";
    in property <bool> destructive: false;
    in property <bool> present: true;

    height: 56px;
    border-radius: Theme.control-radius + 2px;
    border-width: Theme.border-width;
    border-color: destructive ? Theme.warning.with-alpha(0.4) : Theme.border;
    background: destructive ? Theme.warning-soft : Theme.inset;
    accessible-role: groupbox;
    accessible-label: present ? "Target device " + device-name + ", " + device-path + ", " + capacity : "No target device";

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-4;
        spacing: Theme.space-3;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: Theme.control-radius;
                background: root.destructive ? Theme.warning-soft : Theme.track;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 18px;
                    height: 18px;
                    source: @image-url("../../../assets/icons/toolbar/drive.svg");
                    colorize: root.destructive ? Theme.warning : (root.present ? Theme.text : Theme.muted);
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.present ? root.device-name : "No device selected";
                color: root.present ? Theme.text : Theme.muted;
                font-family: Theme.body-font;
                font-size: 13px;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.present ? root.device-path : "Insert a USB drive or refresh the list";
                color: Theme.muted;
                font-family: root.present ? Theme.data-font : Theme.body-font;
                font-size: 11px;
                overflow: elide;
            }
        }
        if root.present: Text {
            horizontal-stretch: 0;
            text: root.capacity;
            color: root.destructive ? Theme.warning : Theme.text;
            font-family: Theme.data-font;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Continuous progress trough with phase and telemetry above it.
export component WriteTrack inherits VerticalLayout {
    in property <string> phase: "READY";
    in property <string> operation: "Ready to write";
    in property <float> progress: 0;
    in property <string> telemetry: "31.9 GB";
    in property <string> tone: "neutral";
    in property <bool> active: false;

    property <color> fill: tone == "error" ? Theme.danger
        : tone == "warning" ? Theme.warning
        : phase == "DONE" ? Theme.success : Theme.accent;

    spacing: Theme.space-2;
    accessible-role: progress-indicator;
    accessible-label: operation;
    accessible-value: progress;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-description: phase + ", " + round(progress) + " percent, " + telemetry;

    HorizontalLayout {
        height: 18px;
        spacing: Theme.space-2;
        Text {
            horizontal-stretch: 1;
            text: root.phase;
            color: root.tone == "error" ? Theme.danger : (root.tone == "warning" ? Theme.warning : (root.active ? Theme.accent : Theme.muted));
            font-family: Theme.data-font;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.4px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            horizontal-stretch: 0;
            text: root.telemetry != "" ? root.telemetry : round(root.progress) + "%";
            color: Theme.muted;
            font-family: Theme.data-font;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    Rectangle {
        height: 8px;
        clip: true;
        border-radius: 4px;
        border-width: Theme.high-contrast ? 1px : 0px;
        border-color: Theme.border;
        background: Theme.track;

        Rectangle {
            x: 0px;
            width: max(0px, min(parent.width, parent.width * root.progress / 100));
            height: parent.height;
            border-radius: 4px;
            background: root.fill;
            animate width { duration: Theme.reduced-motion ? 0ms : 180ms; easing: ease-out; }
        }
    }
}
