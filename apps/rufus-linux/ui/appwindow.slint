// Device Workbench in the T3 Code skin: header bar, flat cards, footer actions.
import { Slider, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    WorkbenchButton, ToolButton, StatusBadge, SectionHeader, ModalOverlay, DialogPanel,
    Card, Callout, CheckRow, SelectField, LabeledComboBox, LabeledLineEdit, TargetPlate,
    WriteTrack, HelperLabel, FieldLabel
} from "components.slint";

export component AppWindow inherits Window {
    title: "Rufus Linux";
    preferred-width: 560px;
    preferred-height: 720px;
    min-width: 480px;
    min-height: 560px;
    background: Theme.canvas;
    icon: @image-url("../../../assets/icons/rufus-linux-64.png");
    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    // —— Bound state from Rust ——
    in-out property <bool> dark-mode <=> Theme.dark-mode;
    in-out property <[string]> device-labels;
    in-out property <int> selected-device: 0;
    in-out property <string> device-name: "No device selected";
    in-out property <string> device-path: "—";
    in-out property <string> device-capacity: "—";
    in-out property <bool> device-risky: false;

    in-out property <[string]> boot-choices;
    in-out property <string> boot-selection: "Disk or ISO image";
    in-out property <string> image-path: "";
    in-out property <string> image-summary: "No image selected";
    in-out property <string> image-notes: "";
    in-out property <bool> image-inspecting: false;
    property <bool> modal-open: root.show-confirm || root.show-log || root.show-about;
    property <bool> can-configure: !root.is-busy && !root.image-inspecting && !root.modal-open;
    property <bool> has-device: root.device-name != "No device selected";
    // Header, content, and footer share one centered column.
    property <length> gutter: max(Theme.space-4, (root.width - Theme.content-max-width) / 2);

    in-out property <[string]> partition-choices;
    in-out property <string> partition-scheme: "GPT";
    in-out property <[string]> target-choices;
    in-out property <string> target-system: "UEFI (non CSM)";
    in-out property <[string]> filesystem-choices;
    in-out property <string> filesystem: "FAT32";
    in-out property <[string]> cluster-choices;
    in-out property <string> cluster-size: "Default";
    in-out property <string> volume-label: "RUFUS";

    in-out property <bool> quick-format: true;
    in-out property <bool> check-bad-blocks: false;
    in-out property <bool> verify-write: true;
    in-out property <bool> list-usb-hdd: false;
    in-out property <bool> list-fixed-disks: false;

    in-out property <float> persistence-gb: 0;
    in-out property <float> persistence-max-gb: 0;
    in-out property <bool> persistence-enabled: false;

    in-out property <string> status-phase: "READY";
    in-out property <string> status-operation: "Ready";
    in-out property <float> status-progress: 0;
    in-out property <string> status-telemetry: "";
    in-out property <string> status-tone: "neutral";
    in-out property <bool> status-active: false;
    in-out property <string> status-line: "Select a device and image, then Start.";

    in-out property <bool> can-start: false;
    in-out property <bool> is-busy: false;
    in-out property <bool> show-confirm: false;
    in-out property <string> confirm-title: "Write image";
    in-out property <string> confirm-body: "";
    in-out property <bool> show-log: false;
    in-out property <string> log-text: "";
    in-out property <bool> show-about: false;
    in-out property <bool> show-advanced: false;
    in-out property <string> capability-hint: "";
    in-out property <string> app-version: "0.1.4";

    // —— Callbacks ——
    callback refresh-devices();
    callback device-selected(string);
    callback boot-selected(string);
    callback select-image();
    callback partition-selected(string);
    callback target-selected(string);
    callback filesystem-selected(string);
    callback cluster-selected(string);
    callback start-clicked();
    callback cancel-clicked();
    callback confirm-accepted();
    callback confirm-rejected();
    callback toggle-log();
    callback toggle-about();
    callback toggle-advanced();
    callback toggle-theme();
    callback compute-checksums();
    callback persistence-changed(float);
    callback option-changed();
    callback close-clicked();

    VerticalLayout {
        // Header bar
        Rectangle {
            height: Theme.header-height;
            vertical-stretch: 0;
            background: Theme.chrome;
            Rectangle {
                y: parent.height - self.height;
                height: Theme.border-width;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: root.gutter;
                padding-right: root.gutter;
                padding-top: (Theme.header-height - Theme.icon-button-size) / 2;
                padding-bottom: (Theme.header-height - Theme.icon-button-size) / 2;
                spacing: Theme.space-1;
                Rectangle { horizontal-stretch: 1; }
                ToolButton { icon: root.dark-mode ? @image-url("../../../assets/icons/toolbar/theme-sun.svg") : @image-url("../../../assets/icons/toolbar/theme.svg"); label: "Switch theme"; enabled: !root.modal-open; clicked => { root.toggle-theme(); } }
                ToolButton { icon: @image-url("../../../assets/icons/toolbar/checksum.svg"); label: "Checksums"; enabled: root.image-path != "" && root.can-configure; clicked => { root.compute-checksums(); } }
                ToolButton { icon: @image-url("../../../assets/icons/toolbar/log.svg"); label: "Log"; enabled: !root.modal-open; selected: root.show-log; clicked => { root.toggle-log(); } }
                ToolButton { icon: @image-url("../../../assets/icons/toolbar/settings.svg"); label: "Advanced"; enabled: !root.modal-open; selected: root.show-advanced; clicked => { root.toggle-advanced(); } }
                ToolButton { icon: @image-url("../../../assets/icons/toolbar/about.svg"); label: "About"; enabled: !root.modal-open; selected: root.show-about; clicked => { root.toggle-about(); } }
            }
        }

        // Scrollable workbench
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            workbench-scroll := Flickable {
                interactive: !root.modal-open;
                viewport-width: self.width;
                viewport-height: workbench.preferred-height;
                workbench := VerticalLayout {
                    width: workbench-scroll.width;
                    padding-left: root.gutter;
                    padding-right: root.gutter;
                    padding-top: Theme.space-4;
                    padding-bottom: Theme.space-4;
                    spacing: Theme.space-3;

                    // Drive
                    Card {
                        SectionHeader { title: "Drive"; }
                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel { label: "Device"; }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                SelectField {
                                    horizontal-stretch: 1;
                                    controlled: true;
                                    accessible-name: "Device";
                                    choices: root.device-labels;
                                    value: root.device-labels[root.selected-device];
                                    enabled: root.can-configure && root.has-device;
                                    selected(v) => { root.device-selected(v); }
                                }
                                WorkbenchButton {
                                    text: "";
                                    icon: @image-url("../../../assets/icons/toolbar/refresh.svg");
                                    compact: true;
                                    enabled: root.can-configure;
                                    accessible-name: "Refresh devices";
                                    clicked => { root.refresh-devices(); }
                                }
                            }
                        }
                        TargetPlate {
                            present: root.has-device;
                            device-name: root.device-name;
                            device-path: root.device-path;
                            capacity: root.device-capacity;
                            destructive: root.device-risky;
                        }
                    }

                    // Boot selection
                    Card {
                        SectionHeader { title: "Boot selection"; }
                        SelectField {
                            accessible-name: "Boot selection";
                            choices: root.boot-choices;
                            value <=> root.boot-selection;
                            enabled: root.can-configure;
                            selected(v) => { root.boot-selected(v); }
                        }
                        if root.boot-selection == "Disk or ISO image" || root.boot-selection == "Windows To Go": VerticalLayout {
                            spacing: 6px;
                            FieldLabel { label: "Image"; }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: Theme.field-height;
                                    border-radius: Theme.control-radius;
                                    border-width: Theme.border-width;
                                    border-color: Theme.input;
                                    background: Theme.inset;
                                    accessible-role: text;
                                    accessible-label: "Image " + (root.image-path == "" ? "not selected" : root.image-path);
                                    HorizontalLayout {
                                        padding-left: Theme.space-3;
                                        padding-right: Theme.space-3;
                                        spacing: Theme.space-2;
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                width: 16px;
                                                height: 16px;
                                                source: @image-url("../../../assets/icons/toolbar/file.svg");
                                                colorize: Theme.muted;
                                            }
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: root.image-path == "" ? "No file selected" : root.image-path;
                                            color: root.image-path == "" ? Theme.muted : Theme.text;
                                            font-family: root.image-path == "" ? Theme.body-font : Theme.data-font;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                                WorkbenchButton {
                                    text: "Select…";
                                    enabled: root.can-configure;
                                    clicked => { root.select-image(); }
                                }
                            }
                            if root.image-summary != "" && root.image-path != "": HelperLabel { message: root.image-summary; }
                        }
                        if root.image-notes != "": HelperLabel { message: root.image-notes; }
                        if root.capability-hint != "": Callout {
                            message: root.capability-hint;
                            tone: "danger";
                        }
                    }

                    // Format options
                    Card {
                        SectionHeader { title: "Format options"; }
                        HorizontalLayout {
                            spacing: Theme.space-3;
                            LabeledComboBox {
                                horizontal-stretch: 1;
                                label: "Partition scheme";
                                choices: root.partition-choices;
                                value <=> root.partition-scheme;
                                enabled: root.can-configure;
                                selected(v) => { root.partition-selected(v); }
                            }
                            LabeledComboBox {
                                horizontal-stretch: 1;
                                label: "Target system";
                                choices: root.target-choices;
                                value <=> root.target-system;
                                enabled: root.can-configure;
                                selected(v) => { root.target-selected(v); }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-3;
                            LabeledComboBox {
                                horizontal-stretch: 1;
                                label: "File system";
                                choices: root.filesystem-choices;
                                value <=> root.filesystem;
                                enabled: root.can-configure;
                                selected(v) => { root.filesystem-selected(v); }
                            }
                            LabeledComboBox {
                                horizontal-stretch: 1;
                                label: "Cluster size";
                                choices: root.cluster-choices;
                                value <=> root.cluster-size;
                                enabled: root.can-configure;
                                selected(v) => { root.cluster-selected(v); }
                            }
                        }
                        LabeledLineEdit {
                            label: "Volume label";
                            value <=> root.volume-label;
                            enabled: root.can-configure;
                        }
                        if root.persistence-enabled: VerticalLayout {
                            spacing: 6px;
                            FieldLabel { label: "Persistence (" + round(root.persistence-gb * 10) / 10 + " GB)"; }
                            Slider {
                                minimum: 0;
                                maximum: max(root.persistence-max-gb, 0.1);
                                value <=> root.persistence-gb;
                                enabled: root.can-configure;
                                released(v) => { root.persistence-changed(v); }
                            }
                        }
                        Rectangle {
                            height: Theme.border-width;
                            background: Theme.border;
                        }
                        VerticalLayout {
                            spacing: Theme.space-2;
                            CheckRow {
                                text: "Quick format";
                                checked <=> root.quick-format;
                                enabled: root.can-configure;
                                toggled => { root.option-changed(); }
                            }
                            CheckRow {
                                text: "Check device for bad blocks";
                                checked <=> root.check-bad-blocks;
                                enabled: root.can-configure;
                                toggled => { root.option-changed(); }
                            }
                            CheckRow {
                                text: "Verify once written";
                                checked <=> root.verify-write;
                                enabled: root.can-configure;
                                toggled => { root.option-changed(); }
                            }
                        }
                    }

                    // Advanced (collapsed by default)
                    if root.show-advanced: Card {
                        tone: "warning";
                        SectionHeader { title: "Expert options"; }
                        Callout {
                            message: "These options can expose disks that hold system data. Use only with disposable media.";
                            tone: "warning";
                        }
                        CheckRow {
                            text: "List USB hard drives";
                            checked <=> root.list-usb-hdd;
                            enabled: root.can-configure;
                            toggled => { root.option-changed(); root.refresh-devices(); }
                        }
                        CheckRow {
                            text: "List fixed / internal disks (dangerous)";
                            checked <=> root.list-fixed-disks;
                            enabled: root.can-configure;
                            toggled => { root.option-changed(); root.refresh-devices(); }
                        }
                    }

                    // Status / write track
                    Card {
                        SectionHeader {
                            title: "Status";
                            StatusBadge {
                                text: root.status-tone == "error" ? "FAILED"
                                    : root.status-phase == "CANCELLED" ? "CANCELLED"
                                    : root.status-phase == "DONE" ? "DONE"
                                    : root.is-busy ? "BUSY"
                                    : root.can-start ? "READY" : "IDLE";
                                tone: root.status-tone == "error" ? "danger"
                                    : root.status-phase == "CANCELLED" || root.is-busy ? "warning"
                                    : root.status-phase == "DONE" || root.can-start ? "success" : "neutral";
                            }
                        }
                        WriteTrack {
                            phase: root.status-phase;
                            operation: root.status-operation;
                            progress: root.status-progress;
                            telemetry: root.status-telemetry;
                            tone: root.status-tone;
                            active: root.status-active;
                        }
                        Text {
                            text: root.status-line;
                            color: Theme.muted;
                            font-family: Theme.body-font;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Thin overlay scrollbar
            if workbench-scroll.viewport-height > workbench-scroll.height: Rectangle {
                property <length> track: workbench-scroll.height - 8px;
                property <length> range: workbench-scroll.viewport-height - workbench-scroll.height;
                x: parent.width - 8px;
                y: 4px + (self.track - self.height) * (-workbench-scroll.viewport-y / self.range);
                width: 6px;
                height: max(32px, self.track * workbench-scroll.height / workbench-scroll.viewport-height);
                border-radius: 3px;
                background: thumb-touch.pressed || thumb-touch.has-hover ? Theme.muted : Theme.input;
                thumb-touch := TouchArea {
                    enabled: !root.modal-open;
                    property <length> start-y;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down { self.start-y = workbench-scroll.viewport-y; }
                    }
                    moved => {
                        workbench-scroll.viewport-y = clamp(
                            self.start-y - (self.mouse-y - self.pressed-y) * parent.range / max(1px, parent.track - parent.height),
                            -parent.range, 0px);
                    }
                }
            }
        }

        // Footer actions
        Rectangle {
            height: Theme.control-height + 2 * Theme.space-3;
            vertical-stretch: 0;
            background: Theme.chrome;
            Rectangle {
                y: 0px;
                height: Theme.border-width;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: root.gutter;
                padding-right: root.gutter;
                padding-top: Theme.space-3;
                padding-bottom: Theme.space-3;
                spacing: Theme.space-2;
                WorkbenchButton {
                    text: "Close";
                    enabled: !root.is-busy && !root.modal-open;
                    clicked => { root.close-clicked(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.is-busy: WorkbenchButton {
                    text: "Cancel";
                    danger: true;
                    enabled: !root.modal-open;
                    clicked => { root.cancel-clicked(); }
                }
                WorkbenchButton {
                    text: root.boot-selection == "Non bootable" ? "Format device" : "Write image";
                    primary: true;
                    enabled: root.can-start && root.can-configure;
                    clicked => { root.start-clicked(); }
                }
            }
        }
    }

    // Confirm overlay
    if root.show-confirm: ModalOverlay {
        keyboard-scroll-enabled: true;
        scroll-content(amount) => {
            confirm-scroll.viewport-y = clamp(confirm-scroll.viewport-y + amount * 1px,
                min(0px, confirm-scroll.height - confirm-scroll.viewport-height), 0px);
        }
        dismiss => { root.confirm-rejected(); }
        restore-focus => { confirm-cancel.focus-button(); }
        advance-focus => {
            if confirm-cancel.has-keyboard-focus { confirm-accept.focus-button(); }
            else { confirm-cancel.focus-button(); }
        }
        DialogPanel {
            tone: "danger";
            width: min(440px, parent.width - 48px);
            height: min(440px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-4;
                Text {
                    text: root.confirm-title;
                    color: Theme.danger;
                    font-family: Theme.display-font;
                    font-size: 16px;
                    font-weight: 600;
                }
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    border-radius: Theme.control-radius;
                    background: Theme.inset;
                    border-width: Theme.border-width;
                    border-color: Theme.border;
                    confirm-scroll := Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-height: confirm-copy.preferred-height + Theme.space-6;
                        confirm-copy := Text {
                            x: Theme.space-3;
                            y: Theme.space-3;
                            width: parent.width - Theme.space-6;
                            text: root.confirm-body;
                            color: Theme.text;
                            font-family: Theme.body-font;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Rectangle { horizontal-stretch: 1; }
                    confirm-cancel := WorkbenchButton {
                        text: "Cancel";
                        initial-focus: true;
                        handles-escape: true;
                        clicked => { root.confirm-rejected(); }
                        escape-pressed => { root.confirm-rejected(); }
                    }
                    confirm-accept := WorkbenchButton {
                        text: root.confirm-title;
                        min-width: 112px;
                        danger: true;
                        handles-escape: true;
                        clicked => { root.confirm-accepted(); }
                        escape-pressed => { root.confirm-rejected(); }
                    }
                }
            }
        }
    }

    // Log overlay
    if root.show-log: ModalOverlay {
        dismiss => { root.toggle-log(); }
        restore-focus => { log-close.focus-button(); }
        advance-focus => { log-close.focus-button(); }
        DialogPanel {
            width: min(560px, parent.width - 32px);
            height: min(460px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-3;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text {
                        horizontal-stretch: 1;
                        text: "Log";
                        color: Theme.text;
                        font-family: Theme.display-font;
                        font-size: 16px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    log-close := WorkbenchButton {
                        text: "Close";
                        initial-focus: true;
                        handles-escape: true;
                        clicked => { root.toggle-log(); }
                        escape-pressed => { root.toggle-log(); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    border-radius: Theme.control-radius;
                    background: Theme.inset;
                    border-width: Theme.border-width;
                    border-color: Theme.border;
                    Flickable {
                        viewport-height: log-body.preferred-height + Theme.space-6;
                        log-body := Text {
                            x: Theme.space-3;
                            y: Theme.space-3;
                            width: parent.width - Theme.space-6;
                            text: root.log-text == "" ? "Log is empty." : root.log-text;
                            color: Theme.muted;
                            font-family: Theme.data-font;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // About overlay
    if root.show-about: ModalOverlay {
        dismiss => { root.toggle-about(); }
        restore-focus => { about-close.focus-button(); }
        advance-focus => { about-close.focus-button(); }
        DialogPanel {
            width: min(420px, parent.width - 48px);
            height: min(about-layout.preferred-height, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            about-layout := VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-3;
                HorizontalLayout {
                    spacing: Theme.space-3;
                    Image {
                        width: 48px;
                        height: 48px;
                        source: @image-url("../../../assets/icons/rufus-linux-48.png");
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Rufus Linux";
                            color: Theme.text;
                            font-family: Theme.display-font;
                            font-size: 18px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Version " + root.app-version;
                            color: Theme.muted;
                            font-family: Theme.data-font;
                            font-size: 12px;
                        }
                    }
                }
                Text {
                    text: "Independent Linux port inspired by Rufus. Formats and writes bootable removable media under GPLv3. Not affiliated with upstream Rufus maintainers.";
                    color: Theme.text;
                    font-family: Theme.body-font;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Destructive writes use a polkit-authorized helper. The desktop process never holds ambient root for raw disks.";
                    color: Theme.muted;
                    font-family: Theme.body-font;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    padding-top: Theme.space-2;
                    Rectangle { horizontal-stretch: 1; }
                    about-close := WorkbenchButton {
                        text: "Close";
                        primary: true;
                        initial-focus: true;
                        handles-escape: true;
                        clicked => { root.toggle-about(); }
                        escape-pressed => { root.toggle-about(); }
                    }
                }
            }
        }
    }
}
